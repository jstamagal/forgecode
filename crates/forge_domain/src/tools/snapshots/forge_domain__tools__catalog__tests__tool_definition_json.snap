---
source: crates/forge_domain/src/tools/catalog.rs
expression: tools
---
{
  "type": "object",
  "properties": {
    "file_path": {
      "description": "Path of the file to read.",
      "type": "string"
    },
    "range": {
      "description": "Optional line range (`start_line`/`end_line`) or byte range\n(`start_byte`/`end_byte`) for partial reads.",
      "type": "object",
      "properties": {
        "end_byte": {
          "description": "0-based offset one past the last byte to read (byte range).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "nullable": true
        },
        "end_line": {
          "description": "Inclusive 1-based last line.",
          "type": "integer",
          "format": "int32",
          "nullable": true
        },
        "start_byte": {
          "description": "0-based byte offset of the first byte to read (byte range).",
          "type": "integer",
          "format": "uint64",
          "minimum": 0,
          "nullable": true
        },
        "start_line": {
          "description": "1-based first line.",
          "type": "integer",
          "format": "int32",
          "nullable": true
        }
      },
      "additionalProperties": false,
      "nullable": true
    },
    "show_line_numbers": {
      "description": "If true, prefixes each line with its line number. Defaults to true.",
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false,
  "required": [
    "file_path"
  ]
}
{
  "type": "object",
  "properties": {
    "content": {
      "description": "The complete file content to write.",
      "type": "string"
    },
    "file_path": {
      "description": "Path of the file to create or replace.",
      "type": "string"
    },
    "overwrite": {
      "description": "Required to replace an existing file; the file must have been read\nfirst and must not have changed since.",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "file_path",
    "content"
  ]
}
{
  "type": "object",
  "properties": {
    "case_insensitive": {
      "description": "Match without case sensitivity.",
      "type": "boolean",
      "nullable": true
    },
    "context": {
      "description": "Lines of context before and after each match (content mode).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "nullable": true
    },
    "context_after": {
      "description": "Lines of context after each match (content mode).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "nullable": true
    },
    "context_before": {
      "description": "Lines of context before each match (content mode).",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "nullable": true
    },
    "file_type": {
      "description": "File type, e.g. rust, py, js (ripgrep type names).",
      "type": "string",
      "nullable": true
    },
    "glob": {
      "description": "Glob filter on paths (e.g. \"*.rs\", \"*.{ts,tsx}\", \"!*.min.js\").",
      "type": "string",
      "nullable": true
    },
    "head_limit": {
      "description": "Maximum result entries after `offset`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "nullable": true
    },
    "line_numbers": {
      "description": "Prefix content lines with their line numbers (default true).",
      "type": "boolean",
      "nullable": true
    },
    "multiline": {
      "description": "Let the regex span lines (`.` matches newlines).",
      "type": "boolean",
      "nullable": true
    },
    "offset": {
      "description": "Result entries to skip before `head_limit`.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0,
      "nullable": true
    },
    "output_mode": {
      "description": "\"content\" (matching lines), \"files_with_matches\" (paths, default) or\n\"count\" (matches per file).",
      "type": "string",
      "enum": [
        "content",
        "files_with_matches",
        "count",
        null
      ],
      "nullable": true
    },
    "path": {
      "description": "File or directory to search (default: the current directory).",
      "type": "string",
      "nullable": true
    },
    "pattern": {
      "description": "Regex to search file contents for.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "pattern"
  ]
}
{
  "description": "Input for the `ast_search` tool: structural search and rewrite.",
  "type": "object",
  "properties": {
    "apply": {
      "description": "Write the rewrite (default false).",
      "type": "boolean"
    },
    "language": {
      "description": "Language (e.g. rust, python, typescript, tsx, go, c, cpp); inferred\nfrom each file's extension when omitted.",
      "type": "string",
      "nullable": true
    },
    "max_results": {
      "description": "Most matches reported (default 200); an apply with more matches is\nrefused.",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "nullable": true
    },
    "path": {
      "description": "File or directory to search (default: the current directory).",
      "type": "string",
      "nullable": true
    },
    "pattern": {
      "description": "ast-grep pattern; `$NAME` matches one node, `$$$NAME` zero or more.",
      "type": "string"
    },
    "rewrite": {
      "description": "Replacement template using the pattern's metavariables; without\n`apply` the result is a diff and nothing is written.",
      "type": "string",
      "nullable": true
    }
  },
  "additionalProperties": false,
  "required": [
    "pattern"
  ]
}
{
  "type": "object",
  "properties": {
    "path": {
      "description": "Path of the file, directory or symlink to remove.",
      "type": "string"
    },
    "permanent": {
      "description": "Delete directly instead of moving to the trash (default false).",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "path"
  ]
}
{
  "description": "Input for the `patch` tool: either the scalar form (`old_string`,\n`new_string`, `replace_all`) or the batch form (`edits`), never both.",
  "type": "object",
  "properties": {
    "edits": {
      "description": "Several replacements applied in order, each seeing the previous\nresult. Never combined with the scalar form.",
      "type": "array",
      "items": {
        "description": "A single replacement inside a batch `patch` call.",
        "type": "object",
        "properties": {
          "new_string": {
            "description": "Replacement text; must differ from old_string.",
            "type": "string"
          },
          "old_string": {
            "description": "Exact text to replace.",
            "type": "string"
          },
          "replace_all": {
            "description": "Replace every occurrence of old_string instead of requiring exactly\none (default false).",
            "type": "boolean",
            "default": false
          }
        },
        "additionalProperties": false,
        "required": [
          "old_string",
          "new_string"
        ]
      },
      "minItems": 1,
      "nullable": true
    },
    "file_path": {
      "description": "Path of the file to modify.",
      "type": "string"
    },
    "new_string": {
      "description": "Replacement text; must differ from old_string (scalar form).",
      "type": "string",
      "nullable": true
    },
    "old_string": {
      "description": "Exact text to replace (scalar form).",
      "type": "string",
      "nullable": true
    },
    "replace_all": {
      "description": "Replace every occurrence of old_string instead of requiring exactly\none (scalar form, default false).",
      "type": "boolean"
    }
  },
  "additionalProperties": false,
  "required": [
    "file_path"
  ]
}
{
  "type": "object",
  "properties": {
    "path": {
      "description": "Path whose latest snapshot should be restored.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "path"
  ]
}
{
  "type": "object",
  "properties": {
    "action": {
      "description": "run (default), poll, wait or kill.",
      "oneOf": [
        {
          "description": "Start `command` and wait up to `timeout` seconds for it.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "Report a running job's new output without waiting.",
          "type": "string",
          "const": "poll"
        },
        {
          "description": "Wait up to `timeout` more seconds for a running job.",
          "type": "string",
          "const": "wait"
        },
        {
          "description": "Stop a running job (SIGTERM, then SIGKILL, to its process group).",
          "type": "string",
          "const": "kill"
        }
      ]
    },
    "command": {
      "description": "The command to run (required for action \"run\").",
      "type": "string",
      "default": ""
    },
    "cwd": {
      "description": "Working directory for the command (default: the current directory).",
      "type": "string",
      "nullable": true
    },
    "description": {
      "description": "Short description of what the command does.",
      "type": "string",
      "nullable": true
    },
    "env": {
      "description": "Extra environment variable names to pass through, on top of the\nconfigured allow-list.",
      "type": "array",
      "items": {
        "type": "string"
      },
      "nullable": true
    },
    "handle": {
      "description": "Job id from a `HANDLE n RUNNING` line, for poll/wait/kill (default:\nthe most recent running job).",
      "type": "string",
      "nullable": true
    },
    "keep_ansi": {
      "description": "Keep ANSI escape codes in the output (default false).",
      "type": "boolean"
    },
    "timeout": {
      "description": "Seconds to wait before returning a handle (run) or to keep waiting\n(wait); default 30. The command is never killed when the window ends.",
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "nullable": true
    }
  },
  "additionalProperties": false
}
{
  "description": "Input type for the net fetch tool",
  "type": "object",
  "properties": {
    "body": {
      "description": "Request body text.",
      "type": "string",
      "nullable": true
    },
    "headers": {
      "description": "Request headers, name to value.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "nullable": true
    },
    "json_body": {
      "description": "Request body as JSON (sets Content-Type: application/json); not with\n`body`.",
      "type": "object",
      "additionalProperties": true,
      "nullable": true
    },
    "method": {
      "description": "HTTP method (default GET).",
      "type": "string",
      "nullable": true
    },
    "raw": {
      "description": "Return the body as is, without HTML-to-markdown conversion (default\nfalse).",
      "type": "boolean",
      "nullable": true
    },
    "save": {
      "description": "Stream the response body to this path instead of returning it; no size\nlimit, resumable.",
      "type": "string",
      "nullable": true
    },
    "url": {
      "description": "URL to fetch: http(s):// or file://.",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "url"
  ]
}
{
  "type": "object",
  "properties": {
    "content": {
      "description": "The content to write to the plan file. This should be the complete\nplan content in markdown format.",
      "type": "string"
    },
    "plan_name": {
      "description": "The name of the plan (will be used in the filename)",
      "type": "string"
    },
    "version": {
      "description": "The version of the plan (e.g., \"v1\", \"v2\", \"1.0\")",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "plan_name",
    "version",
    "content"
  ]
}
{
  "type": "object",
  "properties": {
    "name": {
      "description": "The name of the skill to fetch (e.g., \"pdf\", \"code_review\")",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "name"
  ]
}
{
  "type": "object",
  "properties": {
    "todos": {
      "description": "List of todo items to create or update. Each item must have `content`\nand `status`. The server matches on `content` — if an item with the\nsame content exists it is updated; otherwise a new item is added.\nSet `status` to `cancelled` to remove an item.",
      "type": "array",
      "items": {
        "description": "A single todo item sent by the model.\n\nThe model always provides `content` and `status`. The server uses `content`\nas the key: if an item with the same content already exists it is updated,\notherwise a new item is added. Setting `status` to `cancelled` removes the\nitem from the list entirely. IDs are managed by the server and never\nexposed to the model.",
        "type": "object",
        "properties": {
          "content": {
            "description": "Description of the task. Used as the unique key to match existing todos.",
            "type": "string"
          },
          "status": {
            "description": "Current status of the task. Use `cancelled` to remove the item.",
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "cancelled"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "content",
          "status"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "todos"
  ]
}
{
  "type": "object"
}
{
  "description": "Input structure for the Task tool - delegates work to specialized agents",
  "type": "object",
  "properties": {
    "action": {
      "description": "run (default), poll, wait or kill; poll/wait/kill act on a background\ntask's handle.",
      "oneOf": [
        {
          "description": "Start `command` and wait up to `timeout` seconds for it.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "Report a running job's new output without waiting.",
          "type": "string",
          "const": "poll"
        },
        {
          "description": "Wait up to `timeout` more seconds for a running job.",
          "type": "string",
          "const": "wait"
        },
        {
          "description": "Stop a running job (SIGTERM, then SIGKILL, to its process group).",
          "type": "string",
          "const": "kill"
        }
      ]
    },
    "agent_id": {
      "description": "The agent the workers run as (required to start workers).",
      "type": "string",
      "default": ""
    },
    "background": {
      "description": "Run the workers in the background and return a handle at once.",
      "type": "boolean"
    },
    "handle": {
      "description": "Handle of a background task (default: your most recent running one).",
      "type": "string",
      "nullable": true
    },
    "model": {
      "description": "Model the workers run on instead of the agent's configured model. Leave\nunset unless the user asks for it.",
      "type": "string",
      "nullable": true
    },
    "session_id": {
      "description": "Resume an earlier worker session (one task only). An unknown id is an\nerror.",
      "type": "string",
      "nullable": true
    },
    "tasks": {
      "description": "Self-contained prompts, one per worker; they run in parallel (required\nto start workers).",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "description": "Seconds a wait blocks (default: until the task ends).",
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "nullable": true
    }
  },
  "additionalProperties": false
}
