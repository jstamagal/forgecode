{
  "type": "object",
  "properties": {
    "todos": {
      "description": "List of todo items to create or update. Each item must have `content`\nand `status`. The server matches on `content` — if an item with the\nsame content exists it is updated; otherwise a new item is added.\nSet `status` to `cancelled` to remove an item.",
      "type": "array",
      "items": {
        "description": "A single todo item sent by the model.\n\nThe model always provides `content` and `status`. The server uses `content`\nas the key: if an item with the same content already exists it is updated,\notherwise a new item is added. Setting `status` to `cancelled` removes the\nitem from the list entirely. IDs are managed by the server and never\nexposed to the model.",
        "type": "object",
        "properties": {
          "content": {
            "description": "Description of the task. Used as the unique key to match existing todos.",
            "type": "string"
          },
          "status": {
            "description": "Current status of the task. Use `cancelled` to remove the item.",
            "type": "string",
            "enum": [
              "pending",
              "in_progress",
              "completed",
              "cancelled"
            ]
          }
        },
        "additionalProperties": false,
        "required": [
          "content",
          "status"
        ]
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "todos"
  ]
}
{
  "type": "object"
}
{
  "description": "Input structure for the Task tool - delegates work to specialized agents",
  "type": "object",
  "properties": {
    "action": {
      "description": "run (default), poll, wait or kill; poll/wait/kill act on a background\ntask's handle.",
      "oneOf": [
        {
          "description": "Start `command` and wait up to `timeout` seconds for it.",
          "type": "string",
          "const": "run"
        },
        {
          "description": "Report a running job's new output without waiting.",
          "type": "string",
          "const": "poll"
        },
        {
          "description": "Wait up to `timeout` more seconds for a running job.",
          "type": "string",
          "const": "wait"
        },
        {
          "description": "Stop a running job (SIGTERM, then SIGKILL, to its process group).",
          "type": "string",
          "const": "kill"
        }
      ]
    },
    "agent_id": {
      "description": "The agent the workers run as (required to start workers).",
      "type": "string",
      "default": ""
    },
    "background": {
      "description": "Run the workers in the background and return a handle at once.",
      "type": "boolean"
    },
    "handle": {
      "description": "Handle of a background task (default: your most recent running one).",
      "type": "string",
      "nullable": true
    },
    "model": {
      "description": "Model the workers run on instead of the agent's configured model. Leave\nunset unless the user asks for it.",
      "type": "string",
      "nullable": true
    },
    "session_id": {
      "description": "Resume an earlier worker session (one task only). An unknown id is an\nerror.",
      "type": "string",
      "nullable": true
    },
    "tasks": {
      "description": "Self-contained prompts, one per worker; they run in parallel (required\nto start workers).",
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "timeout": {
      "description": "Seconds a wait blocks (default: until the task ends).",
      "type": "integer",
      "format": "uint64",
      "minimum": 1,
      "nullable": true
    }
  },
  "additionalProperties": false
}
